{
  "name": "@starpivot/dsh-model-capabilities",
  "version": "0.1.0",
  "description": "Background auto-fill of llm-pi-ai model capability fields from overrides → pi-ai catalogs → models.dev",
  "homepage": "https://github.com/StarPivotNet/dsh-plugins-public/tree/main/packages/model-capabilities",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "llm"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarPivotNet/dsh-plugins-public.git",
    "directory": "packages/model-capabilities"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./capabilities": "./lib/capabilities.js",
    "./sources": "./lib/sources.js",
